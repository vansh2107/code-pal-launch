# =============================================================================
# Remonk Reminder — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# This file contains placeholder names ONLY — no real secrets.
# =============================================================================

# Supabase (kept until migration cutover is complete — do not remove early)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Firebase Web SDK (public config — safe to expose in client bundle)
# These values identify the Firebase project. Access is governed by
# Firebase Security Rules and Authentication — they are NOT secrets.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Set to "true" to connect to the local Firebase Emulator Suite during development
VITE_FIREBASE_USE_EMULATOR=false

# OneSignal App ID (public — safe to expose in client bundle)
# The OneSignal REST API key must NEVER appear here — keep it server-side only
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id

# Optional: Cloud Function URL for chatbot SSE streaming (set after first deploy)
# VITE_FIREBASE_CHATBOT_URL=https://us-central1-your-project.cloudfunctions.net/chatbot
